OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Overrides opcionais de modelo por operacao (fallback: OPENAI_MODEL).
# O source_match e uma tarefa simples (escolher entre candidatos ja pontuados)
# e pode rodar num modelo mais barato sem perder qualidade.
OPENAI_MODEL_SOURCE_MATCH=
OPENAI_MODEL_SLIDE_UNDERSTANDING=
OPENAI_MODEL_SLIDE_MATRIX_BUILDER=
OPENAI_MODEL_TRANSFORM_DIAGNOSTICS=
OPENAI_BASE_URL=
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=1
AUTO_PPT_AI_XLSX_DUMP_MODE=compact
AUTO_PPT_AI_XLSX_MAX_CELLS_PER_SHEET=800
AUTO_PPT_AI_AUTO_SOURCE_REVIEW=0
AUTO_PPT_AI_REVIEW_CONFIDENCE_FLOOR=0.80
# Teto de chamadas de IA por passada de revisao de matches (batch de
# AUTO_PPT_AI_SOURCE_MATCH_BATCH_TARGETS targets por chamada; 12x10 = 120 targets).
AUTO_PPT_AI_MATCH_MAX_CALLS=12
AUTO_PPT_AUTO_SLIDE_AI=0
AUTO_PPT_AUTO_SLIDE_AI_MODE=strict
# Maximo de slides revisados com IA pesada (understanding + matriz) por execucao.
AUTO_PPT_SLIDE_AI_MAX_SLIDES_PER_RUN=1
AUTO_PPT_APPLY_SLIDE_AI_OUTPUTS=0

# --- acesso -----------------------------------------------------------------
# Login Microsoft (Entra OIDC). Quando as quatro estao preenchidas, vira o modo
# principal de entrada. ENTRA_REDIRECT_URI precisa ser IDENTICO ao cadastrado no
# registro do aplicativo, incluindo o /auth/callback no fim.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=

# Assina o cookie de sessao. Obrigatorio quando o login Microsoft esta ativo.
# Sem ele, a assinatura cai na senha da equipe.
AUTO_PPT_SESSION_SECRET=

# Senha unica da equipe. Funciona sozinha ou como reserva do login Microsoft.
# Vazia e sem Entra = app aberto (so para uso local).
AUTO_PPT_TEAM_PASSWORD=

AUTO_PPT_RUNTIME_ROOT=
# local: tudo em disco (dev). s3: estado compartilhado entre todos (producao).
AUTO_PPT_STORAGE_BACKEND=local
AUTO_PPT_S3_BUCKET=
AUTO_PPT_S3_PREFIX=auto-ppt

# Gera o PPT em segundo plano, com o navegador acompanhando por polling.
# Ligado por padrao: deck grande estoura o tempo limite da requisicao se a
# geracao acontecer dentro dela. So desligue para depurar localmente.
AUTO_PPT_ASYNC_GENERATION=1

# Guardrails de upload/ZIP. Ajuste em conjunto com CPU, memoria e storage efemero.
AUTO_PPT_MAX_UPLOAD_MB=250
AUTO_PPT_MAX_REQUEST_MB=600
AUTO_PPT_ARCHIVE_MAX_MEMBERS=5000
AUTO_PPT_ARCHIVE_MAX_UNCOMPRESSED_MB=1024
AUTO_PPT_ARCHIVE_MAX_MEMBER_MB=512
AUTO_PPT_ARCHIVE_MAX_RATIO=1000
AUTO_PPT_PREVIEW_WORKERS=2
# Por seguranca, uma formula nao suportada falha. Somente habilite "cached" se
# aceitar explicitamente valores de cache ja gravados pelo autor do XLSX.
AUTO_PPT_FORMULA_FALLBACK=error
